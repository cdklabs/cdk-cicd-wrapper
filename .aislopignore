# Paths excluded from the aislop quality gate. Same syntax as .gitignore.
# These are non-product or build-tooling paths whose findings are false positives for this repo.

# Python MCP server helper — not part of the published npm packages; its `mcp` import is a
# runtime dep declared elsewhere, which aislop's JS-oriented manifest check flags as hallucinated.
mcp-servers/

# The deploy-driver Lambda asset `require()`s @aws-sdk/client-* clients that the Lambda runtime
# provides (so they are intentionally undeclared, see the file header) — an unavoidable
# hallucinated-import false positive for a runtime-provided SDK.
packages/@cdklabs/cdk-cicd-wrapper/src/engine/codepipeline/deploy-driver/

# Docs workshop code samples are illustrative snippets, not shipped code.
docs/

# The per-package .eslintrc.js files are projen-generated build config; their unused `path`
# binding (eslint no-unused-vars) is generator output that cannot be hand-edited.
.eslintrc.js
