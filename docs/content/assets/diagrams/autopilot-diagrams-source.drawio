        <mxCell id="overview-e43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v18" target="overview-v19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="498" /><mxPoint x="1235" y="266" /></Array></mxGeometry></mxCell>
        <mxCell id="overview-l44" value="assumes" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="overview-e43"><mxGeometry x="0.15" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="overview-e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v18" target="overview-v21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="534" /><mxPoint x="1250" y="596" /></Array></mxGeometry></mxCell>
        <mxCell id="overview-e46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v19" target="overview-v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="overview-l47" value="deploys" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="overview-e46"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="overview-e48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="overview-v21" target="overview-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="overview-l49" value="deploys" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="overview-e48"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="overview-v50" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="296" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="overview-v51" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1388" y="216" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="overview-v52" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1168" y="296" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="overview-v53" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1618" y="216" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="overview-v54" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="928" y="466" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="overview-v55" value="&lt;b&gt;One-way doors&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; &lt;code&gt;application&lt;/code&gt; names the pipeline stack (and derives the CDK qualifier when &lt;code&gt;qualifier&lt;/code&gt; is unset). Renaming it creates a new pipeline stack instead of updating this one.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Every stage account is bootstrapped with &lt;code&gt;cdk bootstrap --trust PIPELINE_ACCOUNT&lt;/code&gt; and the same qualifier. A new qualifier means bootstrapping every target again.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The codepipeline and cdk-pipelines engines update themselves on every run. GitHub Actions and both container-mode pipelines do not (pages 2 and 3).&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; A stack's name is its CloudFormation identity: a new name creates a new stack and leaves the old one running.&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; The artifact bucket and key are kept when the pipeline stack is deleted, unless &lt;code&gt;deploy-ci --disposable&lt;/code&gt;." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#5A6C86;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="1010" height="120" as="geometry" /></mxCell>
        <mxCell id="overview-v56" value="&lt;b&gt;Where AI agents fit (page 4)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Before a deploy&lt;/b&gt;, in your editor: &lt;code&gt;cdk-cicd mcp&lt;/code&gt; lets a coding agent validate &lt;code&gt;cicd.config.ts&lt;/code&gt; and list the pipeline it renders.&lt;br&gt;&lt;b&gt;After a failure&lt;/b&gt;, in AWS: the opt-in &lt;code&gt;devopsAgent&lt;/code&gt; block opens an AWS DevOps Agent investigation for each failed action.&lt;br&gt;Separate tools. The old Python MCP debugger is removed; &lt;code&gt;cdk-cicd mcp&lt;/code&gt; replaces it." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#5A6C86;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1080" y="815" width="600" height="120" as="geometry" /></mxCell>
        <mxCell id="overview-v57" value="&lt;b&gt;Open / unverified&lt;/b&gt;&lt;br&gt;devopsAgent on the cdk-pipelines engine and in container mode is covered by unit tests; the live proof deploys the codepipeline engine only.&lt;br&gt;devopsAgent.changeRiskAnalysis (experimental): DevOps Agent accepts the request, but no review has been seen end to end yet (no connected repository in the test account)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF3F3;strokeColor=#DD344C;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="1640" height="75" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="engines" name="2 - Engine shapes">
    <mxGraphModel dx="1720" dy="960" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="engines-v1" value="Engine shapes: what the engine setting renders" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1640" height="30" as="geometry" /></mxCell>
        <mxCell id="engines-v2" value="The same cicd.config.ts renders one of three pipelines. Stage and action names are the ones the engine creates." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1640" height="40" as="geometry" /></mxCell>
        <mxCell id="engines-v3" value="engine: codepipeline (default): one flat CodePipeline, self-updating" style="rounded=1;html=1;whiteSpace=wrap;dashed=0;strokeColor=#C3CBD6;fillColor=#FAFBFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;arcSize=4;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1640" height="220" as="geometry" /></mxCell>
        <mxCell id="engines-v4" value="engine: cdk-pipelines: CDK Pipelines, self-mutating" style="rounded=1;html=1;whiteSpace=wrap;dashed=0;strokeColor=#C3CBD6;fillColor=#FAFBFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;arcSize=4;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="1640" height="220" as="geometry" /></mxCell>
        <mxCell id="engines-v5" value="engine: github-actions: a GitHub workflow, no CodePipeline" style="rounded=1;html=1;whiteSpace=wrap;dashed=0;strokeColor=#C3CBD6;fillColor=#FAFBFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;arcSize=4;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1640" height="190" as="geometry" /></mxCell>
        <mxCell id="engines-v6" value="&lt;b&gt;Source&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="1"><mxGeometry x="90" y="165" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v7" value="&lt;b&gt;Build&lt;/b&gt;&lt;br&gt;npm ci + your npm scripts,&lt;br&gt;synth --all --require-account" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="320" y="165" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v8" value="&lt;b&gt;UpdatePipeline / SelfMutate&lt;/b&gt;&lt;br&gt;cdk-cicd deploy-ci" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="550" y="165" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v9" value="&lt;b&gt;Deploy-&amp;lt;stage&amp;gt;[-&amp;lt;region&amp;gt;]&lt;/b&gt;&lt;br&gt;after Approve-&amp;lt;stage&amp;gt;&lt;br&gt;(not dev or res)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="780" y="165" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v10" value="&lt;b&gt;Await-&amp;lt;stage&amp;gt;&lt;/b&gt;&lt;br&gt;asyncDeploy only: runs the&lt;br&gt;prepared change sets" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1010" y="165" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v11" value="&lt;b&gt;Stage account stacks&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1240" y="165" width="72" height="72" as="geometry" /></mxCell>
