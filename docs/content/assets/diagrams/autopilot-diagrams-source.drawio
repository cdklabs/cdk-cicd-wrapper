        <mxCell id="agents-l10" value="MCP" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="agents-e9"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="agents-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-v6" target="agents-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="agents-l12" value="reads with the&lt;br&gt;CLI's own loader" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="agents-e11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="agents-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#879196;dashed=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-v7" target="agents-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="agents-l14" value="instructions" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="agents-e13"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset" /></mxGeometry></mxCell>
        <mxCell id="agents-v15" value="check_config makes no AWS calls. describe_pipeline runs a pipeline synth, so CDK lookups use your credentials and may write cdk.context.json." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="70" y="670" width="470" height="60" as="geometry" /></mxCell>
