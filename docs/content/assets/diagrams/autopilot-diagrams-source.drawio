        <mxCell id="engines-v18" value="Only this engine reads deployModel, asyncDeploy, express and deployerImage." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1410" y="175" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="engines-v19" value="&lt;b&gt;Source&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="1"><mxGeometry x="90" y="410" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v20" value="&lt;b&gt;Build / Synth&lt;/b&gt;&lt;br&gt;CI, then cdk synth" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v21" value="&lt;b&gt;UpdatePipeline / SelfMutate&lt;/b&gt;&lt;br&gt;cdk deploy of the pipeline stack" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="550" y="410" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v22" value="&lt;b&gt;Assets&lt;/b&gt;&lt;br&gt;publishes file and Docker&lt;br&gt;assets (only if the app has any)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v23" value="&lt;b&gt;&amp;lt;stage&amp;gt;: Prepare / Deploy&lt;/b&gt;&lt;br&gt;a change set per stack&lt;br&gt;in the stage account" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#277116;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engines-v19" target="engines-v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="engines-e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#277116;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engines-v20" target="engines-v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="engines-e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#277116;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engines-v21" target="engines-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="engines-e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#277116;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engines-v22" target="engines-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="engines-v28" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="396" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="engines-v29" value="Several sequential Regions render one pipeline stage per Region, named &amp;lt;stage&amp;gt;&amp;#8209;&amp;lt;region&amp;gt;. Parallel Regions share one wave." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="engines-v30" value="GitHub&lt;br&gt;workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="655" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v31" value="&lt;b&gt;OIDC role + provider&lt;/b&gt;&lt;br&gt;&amp;lt;application&amp;gt;-github-role" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fontColor=#232F3E;strokeColor=none;fillColor=#DD344C;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.role;" vertex="1" parent="1"><mxGeometry x="320" y="655" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-v32" value="&lt;b&gt;Stage account stacks&lt;/b&gt;&lt;br&gt;one job per stage x Region" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="550" y="655" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="engines-e33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#277116;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engines-v30" target="engines-v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="engines-l34" value="assume role (OIDC)" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="engines-e33"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="engines-e35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#277116;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engines-v31" target="engines-v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="engines-l36" value="cdk deploy" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="engines-e35"><mxGeometry x="0.0" relative="1" as="geometry"><mxPoint y="-12" as="offset" /></mxGeometry></mxCell>
        <mxCell id="engines-v37" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="641" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="engines-v38" value="Jobs run on GitHub runners: Build-Synth, then one job per stage x Region with a GitHub Environment. Needs Repository.github." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=0;align=left;verticalAlign=top;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="780" y="665" width="520" height="60" as="geometry" /></mxCell>
        <mxCell id="engines-v39" value="GitHub has no AWS icon, so it is a plain tile." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7D8998;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="665" width="320" height="40" as="geometry" /></mxCell>
        <mxCell id="engines-v40" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; deployModel ASSEMBLY_PROMOTION (default): Build synthesizes every stage once and each Deploy deploys that assembly. DEPLOY_TIME_SYNTH: each stage synthesizes when it deploys.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; cdk-pipelines rejects a forced deployRole with an externalId, which only the codepipeline engine supports.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; No self-update on GitHub Actions: synth checks that the committed workflow is current, and you commit a regenerated one." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#5A6C86;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="1010" height="105" as="geometry" /></mxCell>
        <mxCell id="engines-v41" value="&lt;b&gt;Open / unverified&lt;/b&gt;&lt;br&gt;devopsAgent is wired into the codepipeline and cdk-pipelines engines and rejected on github-actions. The cdk-pipelines wiring has unit tests, not a live deploy." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF3F3;strokeColor=#DD344C;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1080" y="815" width="600" height="105" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="container" name="3 - Container mode">
    <mxGraphModel dx="1720" dy="1010" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1010" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="container-v1" value="Container mode: build the deployer image once, deploy it many times" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1640" height="30" as="geometry" /></mxCell>
        <mxCell id="container-v2" value="Repo 1 builds and pushes a deployer image. Repo 2 decides which version each target runs and deploys it from the image, so no stage rebuilds the application." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1640" height="40" as="geometry" /></mxCell>
        <mxCell id="container-v3" value="Pipeline account" style="rounded=0;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1190" height="720" as="geometry" /></mxCell>
        <mxCell id="container-v4" value="Repo 1: application (cicd.config.ts with deployerImage)" style="rounded=1;html=1;whiteSpace=wrap;dashed=0;strokeColor=#C3CBD6;fillColor=#FAFBFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;arcSize=4;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="1150" height="230" as="geometry" /></mxCell>
        <mxCell id="container-v5" value="Repo 2: deployment config (deploy.config.ts)" style="rounded=1;html=1;whiteSpace=wrap;dashed=0;strokeColor=#C3CBD6;fillColor=#FAFBFC;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;arcSize=4;container=0;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="1150" height="400" as="geometry" /></mxCell>
        <mxCell id="container-v6" value="Stage accounts" style="rounded=0;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="1270" y="110" width="410" height="720" as="geometry" /></mxCell>
        <mxCell id="container-v7" value="&lt;b&gt;Application repo&lt;/b&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fontColor=#232F3E;strokeColor=none;fillColor=#3334B9;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="100" y="210" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v8" value="&lt;b&gt;&amp;lt;application&amp;gt;-pipeline&lt;/b&gt;&lt;br&gt;Source, BuildImage" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v9" value="&lt;b&gt;BuildAndPush&lt;/b&gt;&lt;br&gt;CI, validation synth,&lt;br&gt;docker build and push" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v10" value="&lt;b&gt;&amp;lt;application&amp;gt;-deployer&lt;/b&gt;&lt;br&gt;scan on push; immutable&lt;br&gt;git-SHA tags by default" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="870" y="210" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v11" value="&lt;b&gt;Deploy-config repo&lt;/b&gt;&lt;br&gt;config/&amp;lt;stage&amp;gt;.json pins&lt;br&gt;each target's version" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fontColor=#232F3E;strokeColor=none;fillColor=#3334B9;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1"><mxGeometry x="100" y="470" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v12" value="&lt;b&gt;&amp;lt;repo&amp;gt;-cd-pipeline&lt;/b&gt;&lt;br&gt;Source, Plan, Deploy-&amp;lt;n&amp;gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v13" value="&lt;b&gt;Plan&lt;/b&gt;&lt;br&gt;skips targets whose&lt;br&gt;fingerprint is unchanged" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="560" y="470" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="container-v14" value="&lt;b&gt;Deploy-&amp;lt;stage&amp;gt;&lt;/b&gt;&lt;br&gt;cdk-cicd deploy --from-image&lt;br&gt;--target &amp;lt;stage&amp;gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1"><mxGeometry x="870" y="470" width="72" height="72" as="geometry" /></mxCell>
