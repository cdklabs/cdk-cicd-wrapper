        <mxCell id="container-v38" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="456" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="container-v39" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="948" y="286" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="container-v40" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="456" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="container-v41" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Neither pipeline updates itself. After changing cicd.config.ts or deploy.config.ts, run &lt;code&gt;npx cdk-cicd deploy-ci&lt;/code&gt; again: Repo 2 stops a run whose pipeline shape no longer matches.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; autoDeploy needs the ECR repository in the pipeline's account and Region. A cross-account repository needs crossAccountEcrRepositoryPolicyConfigured and a repository policy on the owner's side.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; A target's version comes from config/&amp;lt;stage&amp;gt;.json (or target.image). autoDeploy targets ignore it and take every new image." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#5A6C86;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="1010" height="115" as="geometry" /></mxCell>
        <mxCell id="container-v42" value="&lt;b&gt;Open / unverified&lt;/b&gt;&lt;br&gt;devopsAgent in Repo 2 (the CD pipeline and every autoDeploy pipeline) has unit tests, not a live deploy. changeRiskAnalysis is not available in container mode: Repo 2 promotes an image, not a commit." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF3F3;strokeColor=#DD344C;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1080" y="855" width="600" height="115" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="agents" name="4 - Agent integrations">
    <mxGraphModel dx="1720" dy="1050" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1050" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="agents-v1" value="Agent integrations: before a deploy in your editor, after a failure in AWS" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1640" height="30" as="geometry" /></mxCell>
        <mxCell id="agents-v2" value="cdk-cicd mcp and the skills help a coding agent work on the config. The opt-in devopsAgent block connects the pipeline to AWS DevOps Agent, which investigates failed runs." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1640" height="40" as="geometry" /></mxCell>
        <mxCell id="agents-v3" value="Your workstation: before a deploy" style="rounded=1;html=1;whiteSpace=wrap;dashed=1;dashPattern=6 6;strokeColor=#3334B9;fillColor=#F5F6FD;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;arcSize=3;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="660" as="geometry" /></mxCell>
        <mxCell id="agents-v4" value="Pipeline account: after a failure (opt-in devopsAgent block)" style="rounded=0;html=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#232F3E;container=0;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="1080" height="660" as="geometry" /></mxCell>
        <mxCell id="agents-v5" value="&lt;b&gt;Coding agent&lt;/b&gt;&lt;br&gt;Claude Code, Kiro, Cursor, ..." style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fontColor=#232F3E;strokeColor=none;fillColor=#232F3E;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="90" y="240" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="agents-v6" value="&lt;b&gt;cdk-cicd mcp&lt;/b&gt; (stdio, local)&lt;br&gt;check_config,&lt;br&gt;describe_pipeline" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=top;verticalAlign=bottom;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.command_line_interface;" vertex="1" parent="1"><mxGeometry x="350" y="240" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="agents-v7" value="&lt;b&gt;Agent skills&lt;/b&gt; (skills/)&lt;br&gt;npx skills add&lt;br&gt;cdklabs/cdk-cicd-wrapper" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fontColor=#232F3E;strokeColor=none;fillColor=#3334B9;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.documents;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="72" height="72" as="geometry" /></mxCell>
        <mxCell id="agents-v8" value="&lt;b&gt;cicd.config.ts&lt;/b&gt;&lt;br&gt;deploy.config.ts" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fontColor=#232F3E;strokeColor=none;fillColor=#3334B9;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;whiteSpace=wrap;labelWidth=200;shape=mxgraph.aws4.documents;" vertex="1" parent="1"><mxGeometry x="350" y="450" width="72" height="72" as="geometry" /></mxCell>
