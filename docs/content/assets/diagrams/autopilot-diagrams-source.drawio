        <mxCell id="agents-v39" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="326" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="agents-v40" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1458" y="326" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="agents-v41" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="586" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="agents-v42" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="958" y="436" width="24" height="24" as="geometry" /></mxCell>
        <mxCell id="agents-v43" value="The DevOps Agent mark needs a current draw.io; older versions draw a blank square." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7D8998;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;dashed=1;" vertex="1" parent="1"><mxGeometry x="1170" y="710" width="490" height="40" as="geometry" /></mxCell>
        <mxCell id="agents-v44" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Off by default, and each level is opt-in: investigations, knowledge, changeRiskAnalysis. Not available on the github-actions engine.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; The Agent Space must be in the pipeline account; knowledge also needs it in the pipeline stack's Region. The wrapper does not create the Agent Space, its account associations or a repository connection.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; Changing agentSpaceId replaces the skill assets (AgentSpaceId does not support updates).&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; changeRiskAnalysis needs a GitHub or CodeStar-connection source, a stage with a manual approval, and the repository connected to the Agent Space. Not in container mode." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#5A6C86;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="1010" height="125" as="geometry" /></mxCell>
        <mxCell id="agents-v45" value="&lt;b&gt;Two tools, two moments&lt;/b&gt;&lt;br&gt;&lt;b&gt;cdk-cicd mcp&lt;/b&gt;: in the editor, before a deploy. Reads the config; free.&lt;br&gt;&lt;b&gt;devopsAgent&lt;/b&gt;: in AWS, after a failed run. Opens an investigation; billed per agent-second.&lt;br&gt;cdk-cicd mcp replaces the removed Python MCP debugger, which read the old Blueprint config." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#5A6C86;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1080" y="795" width="600" height="125" as="geometry" /></mxCell>
        <mxCell id="agents-v46" value="&lt;b&gt;Open / unverified&lt;/b&gt;&lt;br&gt;changeRiskAnalysis: CreateBacklogTask accepts CODE_CHANGE_RISK_ANALYSIS, but no review has been seen end to end. AWS documents chat and pull-request reviews, not this path.&lt;br&gt;The managed AIDevOpsAgentAccessPolicy has no codebuild:BatchGetBuilds; in the live test the agent read the CloudWatch log instead." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF3F3;strokeColor=#DD344C;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingTop=8;spacingRight=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1640" height="75" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
