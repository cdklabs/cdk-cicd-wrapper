{"version": 2, "width": 112, "height": 34, "timestamp": 1787212484, "idle_time_limit": 2.0, "env": {"SHELL": "/usr/bin/zsh", "TERM": ""}, "title": "cdk-cicd-wrapper v3 — M2 real deploy (demo #1)"}
[0.007956, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1;36m 1. Where this recording came from\u001b[0m\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.51218, "o", "\u001b[0;90m# Provenance first: branch, commit, clean tree.\u001b[0m\r\n"]
[3.516066, "o", "\u001b[1;32m$ git rev-parse --abbrev-ref HEAD\u001b[0m\r\n"]
[4.521807, "o", "v3\r\n"]
[4.522043, "o", "\u001b[1;32m$ git rev-parse --short HEAD\u001b[0m\r\n"]
[5.528023, "o", "15e97d9\r\n"]
[5.528093, "o", "\u001b[1;32m$ git status --porcelain | head\u001b[0m\r\n"]
[6.53852, "o", "?? docs/proof/m2-deploy.cast\r\n?? test/proof/demos/m2-deploy.sh\r\n"]
[6.539391, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1;36m 2. What the M2 gate proves\u001b[0m\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[8.04264, "o", "\u001b[0;90m# Two fixtures, deployed for real to the test account:\u001b[0m\r\n"]
[10.047283, "o", "\u001b[0;90m#   level0-app -- a plain 'cdk init' app; its cdk.json runs the app directly.\u001b[0m\r\n"]
[12.050917, "o", "\u001b[0;90m#   level1-app -- identical shape, but its cdk.json runs 'cdk-cicd exec'.\u001b[0m\r\n"]
[14.055639, "o", "\u001b[0;90m# Injection must be DIFFERENTIAL: level0 stays inert (the wrapper adds nothing), level1\u001b[0m\r\n"]
[16.060258, "o", "\u001b[0;90m# is injected (the wrapper applies a config-driven tag tree-wide). We prove it on the\u001b[0m\r\n"]
[18.063464, "o", "\u001b[0;90m# REAL deployed template, then destroy both through the teardown guard.\u001b[0m\r\n"]
[20.066849, "o", "\u001b[1;33m→ Every AWS call below is redacted -- the account id never appears.\u001b[0m\r\n"]
[22.070977, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1;36m 3. Deploy -> assert -> destroy, for real\u001b[0m\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[23.575313, "o", "\u001b[0;90m# One command runs the whole gate. The deploys are real; asciinema compresses the wait.\u001b[0m\r\n"]
[25.579775, "o", "\u001b[1;32m$ bash test/proof/m2-verify.sh\u001b[0m\r\n"]
[26.59608, "o", "   generated run id r20260820075510  (export CDK_CICD_TEST_RUN_ID=r20260820075510 to reuse)\r\n\r\n== m2-verify in us-west-2  (run id r20260820075510)\r\n"]
[27.636606, "o", "\r\n== check-bootstrap\r\n"]
[28.741049, "o", "   us-west-2 bootstrapped, version 29\r\n"]
[29.832436, "o", "   us-west-1 bootstrapped, version 29\r\n"]
