[162.434473, "o", "\r\n== m2-verify PASSED: level0-app inert and level1-app injected, both asserted and destroyed\r\n"]
[162.4348, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1;36m 4. Nothing left behind\u001b[0m\r\n"]
[162.434817, "o", "\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[163.93872, "o", "\u001b[0;90m# The gate destroyed both stacks through the guard. A sweep confirms no fixture orphans\u001b[0m\r\n"]
[165.942586, "o", "\u001b[0;90m# remain -- the only tagged stacks are the CDK bootstrap stacks, which the guard refuses.\u001b[0m\r\n"]
[167.947022, "o", "\u001b[1;32m$ bash test/proof/harness.sh sweep | grep -E \"level0|level1\" || echo \"   no level0/level1 fixture stacks remain\"\u001b[0m\r\n"]
[171.165729, "o", "   no level0/level1 fixture stacks remain\r\n"]
[171.165935, "o", "\r\n\u001b[1;36mM2 verified against real AWS: zero-touch injection, differential and reversible. Demo #1 complete.\u001b[0m\r\n"]
