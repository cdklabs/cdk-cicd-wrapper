[168.86498, "o", "\r\n== leg 2: cdk-cicd deploy --stage drift must be REFUSED by the drift rule\r\n"]
[177.606703, "o", "   leg 2 OK: drift refused the foreign-account deploy for the right reason (nothing deployed)\r\n"]
[177.608455, "o", "\r\n== m3-verify PASSED: multi-region deploy from one build + drift refusal, nothing left behind\r\n"]
[177.608758, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[177.608776, "o", "\u001b[1;36m 4. What just happened\u001b[0m\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[179.113303, "o", "\u001b[0;90m# Leg 1 proved one build reached us-west-2 AND us-west-1, both injected, both destroyed.\u001b[0m\r\n"]
[181.117646, "o", "\u001b[0;90m# Leg 2 proved the drift rule REFUSED a foreign-account deploy -- nothing shipped.\u001b[0m\r\n"]
[183.122106, "o", "\u001b[1;33m→ Nothing is left behind; the teardown guard governed every delete.\u001b[0m\r\n"]
[185.12625, "o", "\r\n\u001b[1;36mM3 verified on real AWS: define once, synth per stage x region, drift-gated, multi-region deploy. Next: the CodePipeline engine (M4).\u001b[0m\r\n"]
