{"version": 2, "width": 100, "height": 30, "timestamp": 1787174051, "idle_time_limit": 2.0, "env": {"SHELL": "/usr/bin/zsh", "TERM": ""}, "title": "cdk-cicd-wrapper v3 — recorder self-test"}
[0.0306, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.037162, "o", "\u001b[1;36m 1. Where this recording came from\u001b[0m\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.935319, "o", "\u001b[0;90m# Every proof states its own provenance, so a viewer can tell which commit\u001b[0m\r\n"]
[2.141856, "o", "\u001b[0;90m# they are looking at and whether the tree was dirty when it was recorded.\u001b[0m\r\n"]
[3.347766, "o", "\u001b[1;32m$ git rev-parse --abbrev-ref HEAD\u001b[0m\r\n"]
[3.955695, "o", "v3\r\n"]
[3.956041, "o", "\u001b[1;32m$ git rev-parse --short HEAD\u001b[0m\r\n"]
[4.573002, "o", "6c3bf14\r\n"]
[4.573428, "o", "\u001b[0;90m# An empty listing below means a clean tree; anything listed was uncommitted.\u001b[0m\r\n"]
[5.780788, "o", "\u001b[1;32m$ git status --porcelain | head -20\u001b[0m\r\n"]
[6.400906, "o", "?? .claude/\r\n?? CLAUDE.md\r\n?? docs/design/\r\n?? docs/proof/\r\n?? findings.json\r\n?? task.md\r\n?? test/\r\n"]
[6.401687, "o", "\r\n"]
[6.401757, "o", "\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1;36m 2. The recording toolchain\u001b[0m\r\n"]
[6.401844, "o", "\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[7.306424, "o", "\u001b[0;90m# asciinema captures the terminal, agg turns the .cast into frames, and\u001b[0m\r\n"]
[8.511406, "o", "\u001b[0;90m# ffmpeg packages those frames as the mp4 that gets attached to the milestone.\u001b[0m\r\n"]
[9.72082, "o", "\u001b[1;32m$ asciinema --version\u001b[0m\r\n"]
[10.425787, "o", "asciinema 2.4.0\r\n"]
[10.437565, "o", "\u001b[1;32m$ agg --version\u001b[0m\r\n"]
[11.046433, "o", "agg 1.9.0\r\n"]
[11.046765, "o", "\u001b[1;32m$ ffmpeg -version | head -1\u001b[0m\r\n"]
[11.660573, "o", "ffmpeg version 7.0.2-static https://johnvansickle.com/ffmpeg/  Copyright (c) 2000-2024 the FFmpeg developers\r\n"]
[11.660972, "o", "\r\n\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[11.661034, "o", "\u001b[1;36m 3. What narration looks like\u001b[0m\r\n"]
[11.661045, "o", "\u001b[1;36m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[12.565579, "o", "\u001b[0;90m# Every command in a demo is preceded by lines like this one, and the pace is\u001b[0m\r\n"]
[13.778073, "o", "\u001b[0;90m# set by DEMO_PAUSE so the viewer has time to read before the command runs.\u001b[0m\r\n"]
[14.984939, "o", "\u001b[1;33m→ DEMO_PAUSE=1.2s for this recording.\u001b[0m\r\n"]
[16.189647, "o", "\u001b[0;90m# Commands themselves are echoed in green with a $ prompt, exactly as a\u001b[0m\r\n"]
[17.394482, "o", "\u001b[0;90m# person would have typed them.\u001b[0m\r\n"]
[18.599926, "o", "\u001b[1;32m$ node --version\u001b[0m\r\n"]
[19.228041, "o", "v24.19.0"]
[19.228366, "o", "\r\n"]
[19.229701, "o", "\r\n"]
[19.229864, "o", "\u001b[1;36mRecorder verified — cast + mp4 are produced by test/proof/record-demo.sh.\u001b[0m\r\n"]
